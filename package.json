{
  "name": "krea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "shots": "node scripts/pr-screenshots.ts .pr-shots.json",
    "qa:segmentado": "node scripts/qa/segmentado.mjs",
    "check:paginas": "node scripts/qa/paginas.mjs",
    "qa:texto-200": "node scripts/qa/texto-200.mjs",
    "test:related": "bun scripts/test-related.ts --dir=tests/unit --dir=tests/db",
    "context:backup": "bash scripts/context-backup.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "context:restore": "bash scripts/context-backup.sh --restore",
    "shots:publish": "bash scripts/publish-pr-shots.sh .pr-shots",
    "test": "bun test ./tests/unit ./tests/db --dots --pass-with-no-tests",
    "qa:local": "node scripts/qa-local.ts",
    "vps:env": "bun scripts/vps-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:db": "bun scripts/seed-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "firebase-scrypt": "^2.2.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.4.2",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
