# URL pública del sitio (metadataBase, sitemap, robots). Dominio final pendiente.
# En Vercel, sin esta variable se usa VERCEL_PROJECT_PRODUCTION_URL; en local, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Firebase (fase 07, D174) ─────────────────────────────────────────────────────────────
# Públicas (van al navegador): Consola de Firebase › Configuración del proyecto › Tus apps › Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# "true" solo en local con los emuladores (qa:local lo pone solo). Nunca en Vercel.
NEXT_PUBLIC_USE_EMULATORS=

# SECRETAS (solo servidor, Admin SDK): Consola › Configuración › Cuentas de servicio ›
# Generar nueva clave privada → client_email y private_key del JSON. En Vercel, --sensitive.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Correo (fase 07, D185): API transaccional de Brevo para «Olvidé mi contraseña» ────────
# Brevo › SMTP y API › Claves API. SECRETA (solo servidor; en Vercel, --sensitive). Sin ella la
# app responde igual al usuario y no envía nada.
BREVO_API_KEY=
# Remitente verificado en Brevo (Remitentes y dominios).
BREVO_SENDER_EMAIL=

# ── Archivos (fase 07, D194): Backblaze B2 por su API compatible con S3 ──────────────────
# Respuestas en imagen (y logos en W8). Bucket PRIVADO: el servidor sube y firma URLs de lectura
# de vida corta. Todas solo servidor. B2 › Application Keys (clave limitada a este bucket).
# SECRETAS (en Vercel, --sensitive):
B2_KEY_ID=
B2_APPLICATION_KEY=
# Nombre del bucket, endpoint S3 (https://s3.<región>.backblazeb2.com) y región (us-east-005).
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=

# QA → solo emulador: contraseña de las cuentas que crea scripts/seed-emulator.ts.
SEED_PASSWORD=
# QA → .env.test.local (D183): la «email» es una CÉDULA del seed del emulador; qa-local le pone
# esta contraseña. Estudiante: p. ej. 33272397 (5A, capitana de G2). Profesor: 10000000.
ESTUDIANTE_EMAIL_TEST=
ESTUDIANTE_PASSWORD_TEST=
PROFESOR_EMAIL_TEST=
PROFESOR_PASSWORD_TEST=
