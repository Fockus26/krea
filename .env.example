# URL pública del sitio (metadataBase, sitemap, robots). Dominio final pendiente.
# En Vercel, sin esta variable se usa VERCEL_PROJECT_PRODUCTION_URL; en local, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Base de datos (D327): Postgres en el VPS ─────────────────────────────────────────────
# Local: `bun run vps:env krea_dev` las escribe en .env.development.local (nunca a mano).
# Vercel: `ssh kit-vps kit-db url krea | vercel env add DATABASE_URL production` (y `krea_preview`
# para Preview). SECRETAS (en Vercel, --sensitive).
DATABASE_URL=
# Conexión directa (sin pool) para las migraciones: necesita el túnel
# `ssh -N -L 5433:127.0.0.1:5432 kit-vps`. Solo local; Vercel no la usa.
DIRECT_URL=

# ── Sesión (D327): Better Auth ───────────────────────────────────────────────────────────
# SECRETA: 32+ caracteres aleatorios (`openssl rand -base64 32`). En Vercel, --sensitive.
BETTER_AUTH_SECRET=
# URL pública del sitio (la misma que NEXT_PUBLIC_SITE_URL); en local, http://localhost:3000.
BETTER_AUTH_URL=

# ── Contraseñas importadas de Firebase (D327) ────────────────────────────────────────────
# Los profesores conservan su contraseña: Consola de Firebase › Authentication › ⋮ › Password hash
# parameters. SECRETAS (en Vercel, --sensitive). Sin ellas, un profe importado entra con
# «Olvidé mi contraseña».
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=
FIREBASE_HASH_MEM_COST=

# ── Correo (fase 07, D185): API transaccional de Brevo para «Olvidé mi contraseña» ────────
# Brevo › SMTP y API › Claves API. SECRETA (solo servidor; en Vercel, --sensitive). Sin ella la
# app responde igual al usuario y no envía nada.
BREVO_API_KEY=
# Remitente verificado en Brevo (Remitentes y dominios).
BREVO_SENDER_EMAIL=

# ── Archivos (fase 07, D194): Backblaze B2 por su API compatible con S3 ──────────────────
# Respuestas en imagen (y logos en W8). Bucket PRIVADO: el servidor sube y firma URLs de lectura
# de vida corta. Todas solo servidor. B2 › Application Keys (clave limitada a este bucket).
# SECRETAS (en Vercel, --sensitive):
B2_KEY_ID=
B2_APPLICATION_KEY=
# Nombre del bucket, endpoint S3 (https://s3.<región>.backblazeb2.com) y región (us-east-005).
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=

# ── Aviso de tarea nueva (D335–D340): Web Push con VAPID ──────────────────────────────────
# `bun scripts/generar-vapid.ts` imprime un par nuevo (córrelo en tu terminal). Sin las tres, Perfil
# no ofrece el aviso y publicar una tarea no envía nada. Cambiar el par obliga a reactivarlo.
# La pública va al navegador:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRETA (solo servidor; en Vercel, --sensitive):
VAPID_PRIVATE_KEY=
# Contacto del remitente para los servicios de push: mailto:<correo>
VAPID_SUBJECT=

# ── % orientativo de IA en Evaluar (D425–D429): API de Claude (Haiku) ─────────────────────
# Claude Console › API Keys. SECRETA (solo servidor; en Vercel, --sensitive). Sin ella el botón
# «Analizar» no aparece. Solo viaja el texto de la respuesta, nunca el nombre ni la cédula.
ANTHROPIC_API_KEY=

# Galerías internas (/componentes, /correos…) en el build: solo el set «preview» de kit-deploy, = 1 (D580).
NEXT_PUBLIC_GALERIAS=

# Desarrollo y QA: contraseña de las cuentas que crea scripts/seed-db.ts (solo bases *_dev o locales).
SEED_PASSWORD=
# QA → .env.test.local (D183): la «email» es una CÉDULA del seed; qa-local le pone esta contraseña. Estudiante: p. ej. 45009896 (5A, capitana de G2). Profesor: 10000000.
ESTUDIANTE_EMAIL_TEST=
ESTUDIANTE_PASSWORD_TEST=
PROFESOR_EMAIL_TEST=
PROFESOR_PASSWORD_TEST=
