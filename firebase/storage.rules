rules_version = '2';

// Storage de KREA (D174, D175): logos de equipo y respuestas en imagen. Fase 07 W1: todo
// cerrado; la unidad que sube imágenes abre aquí solo lo que necesite, con su prueba.
service firebase.storage {
  match /b/{bucket}/o {
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
